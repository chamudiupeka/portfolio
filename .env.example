# TEMPLATE ONLY — this file IS committed to git. Never put a real password here.
# Copy it to .env.local (which is gitignored) and fill the real values in there:
#
#   cp .env.example .env.local

# The Gmail account that SENDS the mail.
GMAIL_USER=you@gmail.com

# A Google *App Password*, not your normal password.
# Requires 2-Step Verification to be on:
#   1. https://myaccount.google.com/security  → turn on 2-Step Verification
#   2. https://myaccount.google.com/apppasswords → create one for "Mail"
#   3. paste the 16 characters into .env.local (spaces are fine, they get stripped)
GMAIL_APP_PASSWORD=

# Optional. Where messages are delivered. Defaults to GMAIL_USER.
# CONTACT_TO=you@gmail.com
